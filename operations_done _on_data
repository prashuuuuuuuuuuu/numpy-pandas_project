Time-Series Analysis:


Extract Year:
df["Year"] = df["Order_Date"].dt.year
Extract Month:
df["Month"] = df["Order_Date"].dt.month
Extract Month Name:
df["Month_Name"] = df["Order_Date"].dt.month_name()
Extract Quarter:
df["Quarter"] = df["Order_Date"].dt.quarter
Yearly Sales:
df.groupby("Year")["Final_Sales"].sum()
Yearly Quantity:
df.groupby("Year")["Quantity"].sum()
Yearly Orders:
df.groupby("Year")["Order_ID"].nunique()
Yearly AOV:
yearly_analysis = df.groupby("Year").agg(
    Sales=("Final_Sales", "sum"),
    Orders=("Order_ID", "nunique")
)

yearly_analysis["AOV"] = (
    yearly_analysis["Sales"] /
    yearly_analysis["Orders"]
)
Monthly Sales:
monthly_sales = df.groupby(
    "Month"
)["Final_Sales"].sum()
Monthly Analysis:
monthly_analysis = df.groupby("Month").agg(
    Sales=("Final_Sales", "sum"),
    Orders=("Order_ID", "nunique"),
    Quantity=("Quantity", "sum")
)
Monthly AOV:
monthly_analysis["AOV"] = (
    monthly_analysis["Sales"] /
    monthly_analysis["Orders"]
)
Month-over-Month Change:
monthly_analysis["Sales_Change"] = (
    monthly_analysis["Sales"].diff()
)
Month-over-Month Growth %:
monthly_analysis["MoM_Growth_%"] = (
    monthly_analysis["Sales"].pct_change() * 100
)
Order Growth %:
monthly_analysis["Order_Growth_%"] = (
    monthly_analysis["Orders"].pct_change() * 100
)
Quantity Growth %:
monthly_analysis["Quantity_Growth_%"] = (
    monthly_analysis["Quantity"].pct_change() * 100
)
3-Month Moving Average:
monthly_analysis["3_Month_Moving_Avg"] = (
    monthly_analysis["Sales"]
    .rolling(window=3)
    .mean()
)
Quarterly Sales:
df.groupby(
    ["Year", "Quarter"]
)["Final_Sales"].sum()




